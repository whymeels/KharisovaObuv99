<Page x:Class="KharisovaObuv.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:KharisovaObuv"
      mc:Ignorable="d"
      d:DesignHeight="800"
      d:DesignWidth="1200"
      Title="OrdersPage"
      FontFamily="Calibri"
      Background="White">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="110"/>
        </Grid.RowDefinitions>


        <!-- Заголовок -->
        <Border Grid.Row="0"
                Background="#D2F6E7">

            <TextBlock Text="Список заказов"
                       FontSize="26"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="25,0"/>

        </Border>


        <!-- Таблица заказов -->
        <DataGrid x:Name="OrdersDG"
                  Grid.Row="1"
                  Margin="20"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  FontSize="15">

            <DataGrid.Columns>

                <DataGridTextColumn Header="№ заказа"
                                    Binding="{Binding OrderID}"
                                    Width="100"/>

                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy}}"
                                    Width="150"/>

                <DataGridTextColumn Header="Клиент"
                                    Binding="{Binding ClientFullName}"
                                    Width="*"/>

                <DataGridTextColumn Header="Сумма, руб."
                                    Binding="{Binding TotalAmount, StringFormat={}{0:0.00}}"
                                    Width="150"/>

            </DataGrid.Columns>

        </DataGrid>


        <!-- Кнопки -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="20">

            <Button x:Name="AddOrderBtn"
                    Content="Новый заказ"
                    Width="130"
                    Height="35"
                    Margin="0,0,10,0"
                    Background="#70B2AF"
                    Foreground="White"
                    BorderThickness="0"
                    Click="AddOrderBtn_Click"/>

            <Button x:Name="OpenOrderBtn"
                    Content="Открыть"
                    Width="110"
                    Height="35"
                    Margin="0,0,10,0"
                    Background="#70B2AF"
                    Foreground="White"
                    BorderThickness="0"
                    Click="OpenOrderBtn_Click"/>

            <Button x:Name="DeleteOrderBtn"
                    Content="Удалить"
                    Width="110"
                    Height="35"
                    Background="#70B2AF"
                    Foreground="White"
                    BorderThickness="0"
                    Click="DeleteOrderBtn_Click"/>

        </StackPanel>

    </Grid>

</Page>