<Page x:Class="KharisovaObuv.OrderDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:KharisovaObuv"
      mc:Ignorable="d"
      d:DesignHeight="700"
      d:DesignWidth="1000"
      Title="OrderDetailsPage"
      FontFamily="Calibri"
      Background="White">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0"
                Background="#D2F6E7">

            <TextBlock x:Name="OrderTitleTB"
                       Text="Заказ"
                       FontSize="26"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="25,0"/>
        </Border>

        <!-- Информация о заказе -->
        <StackPanel Grid.Row="1"
                    Margin="25,20,25,10">

            <TextBlock x:Name="ClientTB"
                       FontSize="17"
                       Margin="0,0,0,5"/>

            <TextBlock x:Name="DateTB"
                       FontSize="17"
                       Margin="0,0,0,5"/>

        </StackPanel>

        <!-- Состав заказа -->
        <DataGrid x:Name="OrderItemsDG"
                  Grid.Row="2"
                  Margin="25,5,25,10"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  FontSize="14">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Товар"
                                    Binding="{Binding ProductName}"
                                    Width="*"/>

                <DataGridTextColumn Header="Размер"
                                    Binding="{Binding SizeValue}"
                                    Width="100"/>

                <DataGridTextColumn Header="Количество"
                                    Binding="{Binding Quantity}"
                                    Width="120"/>

                <DataGridTextColumn Header="Цена, руб."
                                    Binding="{Binding UnitPrice, StringFormat={}{0:0.00}}"
                                    Width="130"/>

                <DataGridTextColumn Header="Сумма, руб."
                                    Binding="{Binding LineTotal, StringFormat={}{0:0.00}}"
                                    Width="130"/>

            </DataGrid.Columns>

        </DataGrid>

        <!-- Низ -->
        <Grid Grid.Row="3"
              Margin="25,5,25,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TotalTB"
                       Grid.Column="0"
                       Text="Итого: 0 руб."
                       FontSize="21"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Button x:Name="EditOrderBtn"
                    Grid.Column="1"
                    Content="Редактировать"
                    Width="150"
                    Height="35"
                    Background="#70B2AF"
                    Foreground="White"
                    BorderThickness="0"
                    Visibility="Collapsed"
                    Click="EditOrderBtn_Click"/>

        </Grid>

    </Grid>

</Page>