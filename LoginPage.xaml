<Page x:Class="KharisovaObuv.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KharisovaObuv"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage" Background="White" FontFamily="Calibri">

    <Grid>
        <StackPanel Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Авторизация" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>
            <TextBlock Text="Логин"/>
            <TextBox Name="LoginTB" Height="30" Margin="0,5,0,20"/>
            <Button Content="Войти" Name="LoginBtn" Height="35" Foreground="White" BorderThickness="0" Click="LoginBtn_Click"/>
            <Button Content="Войти как гость" Name="GuestBtn" Height="35" Margin="0,10,0,0" Foreground="White"  BorderThickness="0" Click="GuestBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>
