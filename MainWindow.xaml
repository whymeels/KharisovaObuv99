<Window x:Class="KharisovaObuv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KharisovaObuv"
        mc:Ignorable="d"
        Title="Чудо Обувь"
        Height="800"
        Width="1400"
        MinHeight="1000"
        MinWidth="1400"
        WindowStartupLocation="CenterScreen"
        Icon="/res/Чудо Обувь.ico"
        FontFamily="Calibri"
        Background="White">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- Верхняя панель -->
        <Border Grid.Row="0"
                Background="#D2F6E7">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>


                <!-- Логотип -->
                <Image Grid.Column="0"
                       Source="/res/Чудо Обувь.png"
                       Height="60"
                       MaxWidth="180"
                       Margin="15,5"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"/>


                <!-- Название -->
                <TextBlock Grid.Column="1"
                           Text="Чудо Обувь"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>


                <!-- Назад -->
                <Button Grid.Column="2"
                        Content="Назад"
                        x:Name="BtnBack"
                        Width="100"
                        Height="35"
                        Margin="15"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#70B2AF"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="15"
                        Click="BtnBack_Click"/>

            </Grid>

        </Border>


        <!-- Здесь открываются страницы -->
        <Frame Grid.Row="1"
               x:Name="MainFrame"
               ContentRendered="MainFrame_ContentRendered"
               NavigationUIVisibility="Hidden"/>

    </Grid>

</Window>